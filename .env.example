# Prefer: python scripts/init_env.py
MYSQL_ROOT_PASSWORD=replace-with-random-value
MYSQL_PASSWORD=replace-with-random-value
BID_BOOTSTRAP_API_KEY=replace-with-random-value-at-least-24-characters

# New uploads/reparse use local MinerU 4.0.12; old artifacts keep their frozen profile.
BID_PARSER_PROFILE=mineru-4.0.12-flash-auto-v1
BID_MINERU_TIMEOUT_SECONDS=900

# Optional model extraction. Keep disabled until you choose and configure a provider.
BID_LLM_ENABLED=false
BID_LLM_BASE_URL=https://api.openai.com/v1
BID_LLM_API_KEY=
BID_LLM_MODEL=
BID_LLM_OUTPUT_MODE=json_schema
BID_LLM_TOKEN_PARAMETER=max_completion_tokens
BID_LLM_TIMEOUT_SECONDS=45
BID_LLM_MAX_OUTPUT_TOKENS=4096
# Only for an explicitly configured local test/model server; cloud endpoints should use HTTPS.
BID_LLM_ALLOW_INSECURE_HTTP=false
